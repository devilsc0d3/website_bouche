RewriteEngine On

# Redirection des accès directs aux pages vers leur route propre
RewriteRule ^front/web/about.html$ /about [R=301,L]
RewriteRule ^front/web/mention-legal.html$ /mention-legal [R=301,L]
RewriteRule ^front/web/sitemap.html$ /sitemap [R=301,L]
RewriteRule ^front/web/index.html$ / [R=301,L]

# Redirection des routes
RewriteRule ^$ front/web/index.html [L] 
RewriteRule ^about$ front/web/about.html [L]
RewriteRule ^mention-legal$ front/web/mention-legal.html [L]
RewriteRule ^sitemap$ front/web/sitemap.html [L]

# Redirections des erreurs
ErrorDocument 404 /front/web/404.html
ErrorDocument 403 /front/web/403.html

# securité pour les images
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !bouche-jc\.fr [NC]
RewriteRule \.(jpg|jpeg|png|gif)$ - [F]

